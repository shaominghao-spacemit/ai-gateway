#!/bin/sh
set -e
case "$1" in
    install|upgrade)
        # unpack 会先删除旧包的 /opt 配置，必须在此之前备份。
        legacy=/opt/spacemit-ai-gateway/configs/base.yaml
        backup=/etc/spacemit-ai-gateway/legacy-base.yaml
        if [ -f "$legacy" ] && [ ! -e "$backup" ]; then
            install -d -m 0755 /etc/spacemit-ai-gateway
            install -m 0600 "$legacy" "$backup"
        fi
        if [ -f "$legacy" ] || [ -f "$backup" ]; then
            # 新 unit unpack 前记录旧进程实际 HOME/环境，不能用 sudo 调用者猜测。
            /usr/bin/python3 - <<'PYCONTEXT'
import glob
import json
import os
from pathlib import Path
import pwd
import re
import shlex
import subprocess
import tempfile



def parse_environment(text):
    # preinst 在 unpack 前不能导入此文件；两份解析器由回归检查一致性。
    if any(char in '\0\ufeff' or 0xfdd0 <= ord(char) <= 0xfdef
           or ord(char) & 0xffff in (0xfffe, 0xffff) for char in text):
        raise ValueError('Invalid character in systemd EnvironmentFile')
    result = {}
    index = 0
    while index < len(text):
        newline = re.search(r'[\r\n]', text[index:])
        line_end = index + newline.start() if newline else len(text)
        assignment = re.match(r'[ \t]*([A-Za-z_][A-Za-z0-9_]*)[ \t]*=', text[index:line_end])
        if assignment is None:
            index = line_end + 1
            continue
        key = assignment[1]
        index += assignment.end()
        state = 'start'
        value = []
        end = 0
        while index < len(text):
            char = text[index]
            index += 1
            if state == 'start':
                if char in ' \t':
                    continue
                if char in '\r\n':
                    break
                if char in "'\"":
                    state = char
                    continue
                state = 'plain'
            if state == 'plain':
                if char in '\r\n':
                    break
                if char == '\\':
                    if index < len(text):
                        following = text[index]
                        index += 1
                        if following not in '\r\n':
                            value.append(following)
                        end = len(value)
                    continue
                value.append(char)
                if char not in ' \t\r':
                    end = len(value)
            else:
                if char == state:
                    state = 'start'
                    continue
                if state == '"' and char == '\\':
                    if index == len(text):
                        continue
                    char = text[index]
                    index += 1
                    if char == '\n':
                        continue
                    if char not in '\\"`$':
                        value.append('\\')
                value.append(char)
                end = len(value)
        result[key] = ''.join(value[:end])
    return result


def read_environment(path):
    return parse_environment(path.read_bytes().decode('utf-8', errors='surrogateescape'))


def read_environment_files(root, name, optional):
    if not Path(name).is_absolute() or any(char in name for char in '\\%'):
        raise RuntimeError('Cannot resolve legacy EnvironmentFile path: ' + name)
    # 保留文件项顺序；同一 wildcard 内按文件名排序，不能把可选 pattern 当成不存在的字面路径。
    paths = sorted(glob.glob(glob.escape(str(root)) + '/' + name.lstrip('/')))
    if not paths and not optional:
        raise FileNotFoundError('Required legacy EnvironmentFile has no matches: ' + name)
    values = {}
    for path in paths:
        try:
            values.update(read_environment(Path(path)))
        except FileNotFoundError:
            if not optional:
                raise
    return values


def offline_context(root, name='spacemit-ai-gateway.service', optional=False):
    # 仅解析旧身份/环境所需的常见 unit 语法；不执行 shell、不猜调用者 HOME。
    directories = [root / prefix for prefix in (
        'etc/systemd/system', 'run/systemd/system', 'usr/local/lib/systemd/system',
        'usr/lib/systemd/system', 'lib/systemd/system')]
    unit = next((directory / name for directory in directories
                 if (directory / name).exists() or (directory / name).is_symlink()), None)
    if optional and (unit is None or unit.resolve() == Path('/dev/null')):
        return {}, {}
    if unit is None or not unit.is_file() or unit.resolve() == Path('/dev/null'):
        raise RuntimeError('Cannot inspect legacy gateway identity: no usable offline unit')
    dropins = {}
    # 同名文件：具体服务优先于前缀/全局，/etc 优先于 vendor；最后按文件名合并。
    prefixes = [name[:index + 1] + '.service.d' for index, char in enumerate(name) if char == '-']
    for scope in ('service.d', *prefixes, name + '.d'):
        for directory in reversed(directories):
            dropins.update({path.name: path for path in (directory / scope).glob('*.conf')})
    properties = {'MainPID': '0'}
    environment = {}
    files = []
    for path in [unit, *(dropins[key] for key in sorted(dropins))]:
        if path.is_symlink() and path.resolve() == Path('/dev/null'):
            continue
        section = ''
        for line in path.read_text().replace('\\\n', ' ').splitlines():
            line = line.strip()
            if not line or line.startswith(('#', ';')):
                continue
            if line.startswith('[') and line.endswith(']'):
                section = line
                continue
            if section != '[Service]' or '=' not in line:
                continue
            key, value = (part.strip() for part in line.split('=', 1))
            if key == 'ExecStart':
                if value and properties.get(key):
                    raise RuntimeError('Cannot migrate multiple legacy service start commands')
                properties[key] = value
            elif key in ('User', 'WorkingDirectory', 'Environment', 'EnvironmentFile'):
                if '%' in value or '\\' in value:
                    raise RuntimeError('Cannot resolve offline legacy unit specifiers or escapes')
                if key == 'Environment':
                    if not value:
                        environment.clear()
                    for entry in shlex.split(value, comments=False):
                        variable, separator, content = entry.partition('=')
                        if not separator:
                            raise RuntimeError('Invalid offline legacy unit environment')
                        environment[variable] = content
                elif key == 'EnvironmentFile':
                    if not value:
                        files.clear()
                    else:
                        files.extend(shlex.split(value, comments=False))
                else:
                    values = shlex.split(value, comments=False)
                    properties[key] = values[0] if len(values) == 1 else ''
                    if len(values) > 1:
                        raise RuntimeError('Ambiguous offline legacy unit identity or directory')
            elif ((key == 'DynamicUser' and value.lower() not in ('', 'no', 'false', '0')) or
                  (key in ('RootDirectory', 'RootImage', 'PAMName', 'PassEnvironment', 'UnsetEnvironment') and value)):
                raise RuntimeError('Cannot resolve offline legacy unit identity/environment directive: ' + key)
    for value in files:
        optional = value.startswith('-')
        name = value[1:] if optional else value
        environment.update(read_environment_files(root, name, optional))
    return properties, environment


def snapshot(root=Path("/"), proc=Path("/proc")):
    etc = root / 'etc/spacemit-ai-gateway'
    destination = etc / 'legacy-context.json'
    if destination.exists():
        return
    try:
        in_chroot = not os.path.samefile(root, proc / '1/root')
    except OSError:
        in_chroot = False
    result = None
    if not in_chroot:
        try:
            result = subprocess.run(
                ['systemctl', 'show', 'spacemit-ai-gateway.service',
                 '--property=MainPID,User,Environment,EnvironmentFiles,WorkingDirectory'],
                capture_output=True, text=True, check=False)
        except FileNotFoundError:
            pass
    offline = result is None or result.returncode != 0 or not result.stdout.strip()
    if offline:
        # 正常运行的 systemd 查询失败仍不能用静态配置冒充当前进程环境。
        if not in_chroot and (root / 'run/systemd/system').exists():
            raise RuntimeError('Cannot inspect legacy gateway identity before upgrade')
        properties, environment = offline_context(root)
    else:
        properties = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
        environment = dict(value.split('=', 1) for value in shlex.split(properties.get('Environment', '')) if '=' in value)
    pid = properties.get('MainPID', '0')
    if pid != '0':
        # 运行中的进程才是有效配置的最终证据，包含所有 EnvironmentFile 覆盖。
        raw = (proc / pid / 'environ').read_bytes()
        environment.update(dict(value.split('=', 1) for value in raw.decode().split('\0') if '=' in value))
    elif not offline:
        # 旧 maintainer prerm 可能已停止服务；EnvironmentFile 不反映在 show Environment。
        files = properties.get('EnvironmentFiles', '')
        remaining = files
        while remaining:
            match = re.match(r'(.*?) \(ignore_errors=(yes|no)\)(?: |$)', remaining)
            if match is None:
                raise RuntimeError('Cannot resolve legacy systemd EnvironmentFiles')
            name, optional = match.groups()
            environment.update(read_environment_files(root, name, optional == 'yes'))
            remaining = remaining[match.end():]
        if 'EnvironmentFiles' not in properties:
            # 兼容旧 systemd 未返回此属性的情况，优先读取有效 unit 的文件列表。
            unit, values = offline_context(root, optional=True)
            environment.update(values)
            if not unit:
                for name in ('credentials.env', 'environment'):
                    path = etc / name
                    if path.is_file():
                        environment.update(read_environment(path))
    user = properties.get('User') or 'root'
    home = environment.get('HOME') or (pwd.getpwuid(int(user)) if user.isdigit() else pwd.getpwnam(user)).pw_dir
    config = environment.get('SPACEMIT_AI_GATEWAY_CONFIG')
    if config:
        # 管理员自选 YAML 也在旧 HOME 和 WorkingDirectory 下解析，源文件留存。
        config = config.replace('~/', home.rstrip('/') + '/', 1) if config.startswith('~/') else config
        config_path = Path(config)
        if not config_path.is_absolute():
            config_path = Path(properties.get('WorkingDirectory') or '/opt/spacemit-ai-gateway') / config_path
        effective = etc / 'legacy-effective-base.yaml'
        if not effective.exists():
            source = root / str(config_path).lstrip('/')
            if not source.is_file():
                # 升级/回滚可能留下指向新配置路径的旧 drop-in，而该文件尚未解包。
                source = root / 'opt/spacemit-ai-gateway/configs/base.yaml'
            if not source.is_file():
                source = None
            if source is not None:
                contents = source.read_bytes()
                fd, pending = tempfile.mkstemp(prefix='.legacy-config-', dir=etc)
                try:
                    with os.fdopen(fd, 'wb') as stream:
                        stream.write(contents)
                        stream.flush()
                        os.fsync(stream.fileno())
                    os.replace(pending, effective)
                finally:
                    if os.path.exists(pending):
                        os.unlink(pending)
    context = {'user': user, 'home': home,
               'working_directory': properties.get('WorkingDirectory') or '/opt/spacemit-ai-gateway',
               'environment': {key: value for key, value in environment.items()
                               if key.startswith('SPACEMIT_AI_GATEWAY_') or key == 'XDG_CACHE_HOME'}}
    frontend, _ = offline_context(root, 'spacemit-ai-gateway-frontend.service', optional=True)
    if frontend.get('ExecStart'):
        context['frontend_exec_start'] = frontend['ExecStart']
    fd, temporary = tempfile.mkstemp(prefix='.legacy-context-', dir=etc)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(context, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


if __name__ == '__main__':
    snapshot()
PYCONTEXT
        fi
        ;;
    abort-upgrade) ;;
    *) echo "Unexpected preinst argument: $1" >&2; exit 1 ;;
esac
#DEBHELPER#
exit 0
