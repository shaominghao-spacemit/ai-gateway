#!/bin/sh
set -e
case "$1" in
    configure)
        if ! getent passwd spacemit-ai-gateway >/dev/null; then
            adduser --system --group --home /var/lib/spacemit-ai-gateway --no-create-home spacemit-ai-gateway
        fi
        /usr/bin/python3 - <<'PYUSER'
import grp
import pwd
user = pwd.getpwnam('spacemit-ai-gateway')
if user.pw_uid == 0 or user.pw_dir != '/var/lib/spacemit-ai-gateway' or user.pw_gid != grp.getgrnam('spacemit-ai-gateway').gr_gid:
    raise SystemExit('Existing gateway account has an unexpected identity or home; fix the account before retrying')
PYUSER
        if ! getent group bibit-asr >/dev/null; then
            addgroup --system bibit-asr
        fi
        adduser spacemit-ai-gateway bibit-asr >/dev/null
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/spacemit-ai-gateway-asr.conf
        for group in audio video render; do
            if getent group "$group" >/dev/null; then
                adduser spacemit-ai-gateway "$group" >/dev/null
            fi
        done
        install -d -m 0750 -o spacemit-ai-gateway -g spacemit-ai-gateway /var/lib/spacemit-ai-gateway
        install -d -m 0755 /etc/spacemit-ai-gateway
        /usr/bin/python3 /usr/lib/spacemit-ai-gateway/runtime.py ensure-voice-key
        /usr/bin/python3 /usr/lib/spacemit-ai-gateway/runtime.py grant-voice-key
        /usr/bin/python3 /usr/lib/spacemit-ai-gateway/runtime.py install
        /opt/spacemit-ai-gateway/venv/bin/python /usr/lib/spacemit-ai-gateway/runtime.py migrate
        ;;
    abort-upgrade|abort-remove|abort-deconfigure) ;;
    *) echo "Unexpected postinst argument: $1" >&2; exit 1 ;;
esac
#DEBHELPER#
exit 0
