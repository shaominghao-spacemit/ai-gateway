[Unit]
Description=SpacemiT AI Gateway
After=network.target

[Service]
Type=simple
User=spacemit-ai-gateway
Group=spacemit-ai-gateway
SupplementaryGroups=bibit-asr
Environment=HOME=/var/lib/spacemit-ai-gateway
Environment=PYTHONNOUSERSITE=1
Environment=PATH=/opt/spacemit-ai-gateway/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=SPACEMIT_AI_GATEWAY_CONFIG=/etc/spacemit-ai-gateway/base.yaml
EnvironmentFile=-/etc/spacemit-ai-gateway/credentials.env
EnvironmentFile=-/etc/spacemit-ai-gateway/environment
ExecStart=/opt/spacemit-ai-gateway/venv/bin/spacemit-ai-gateway
WorkingDirectory=/var/lib/spacemit-ai-gateway
StateDirectory=spacemit-ai-gateway
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
ProtectSystem=full
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
