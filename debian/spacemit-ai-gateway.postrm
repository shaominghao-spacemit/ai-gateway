#!/bin/sh
set -e
case "$1" in
    remove|purge)
        # remove 时包内 helper 已被 dpkg 删除；postrm 自包含，只清理带包标记的运行环境。
        /usr/bin/python3 - <<'PY'
import os
from pathlib import Path
import re
import shutil
app = Path('/opt/spacemit-ai-gateway')
link = app / 'venv'
if link.is_symlink() and re.fullmatch(r'runtime-[a-f0-9]{20}', os.readlink(link)):
    link.unlink()
for path in app.glob('runtime-*'):
    if path.is_dir() and not path.is_symlink() and (path / '.gateway-runtime').is_file():
        shutil.rmtree(path)
PY
        if [ "$1" = purge ]; then
            # 恢复源与活迁移状态分离，保留权限回滚资料但不污染 purge 后的新装。
            /usr/bin/python3 - <<'PYBACKUP'
import os
from pathlib import Path
import tempfile
etc = Path('/etc/spacemit-ai-gateway')
names = [
    'legacy-base.yaml', 'legacy-effective-base.yaml', 'legacy-context.json',
    'legacy-storage-acl.jsonl', 'legacy-credentials.env', 'legacy-environment',
    'spacemit-ai-gateway-legacy-runtime-user.conf',
    'spacemit-ai-gateway-frontend-legacy-runtime-user.conf',
]
sources = [etc / name for name in names if (etc / name).exists() or (etc / name).is_symlink()]
if any(path.is_symlink() or not path.is_file() for path in sources):
    raise SystemExit('Migration recovery source is not a regular file')
if sources:
    backups = etc / 'migration-backups'
    if backups.is_symlink():
        raise SystemExit('Migration backup directory must not be a symlink')
    backups.mkdir(mode=0o700, exist_ok=True)
    backups.chmod(0o700)
    destination = Path(tempfile.mkdtemp(prefix='purge-', dir=backups))
    for path in sources:
        path.chmod(0o600)
        os.rename(path, destination / path.name)
for pattern in ('.legacy-storage-migrated', '.legacy-assets-migrated', '.legacy-admin-storage-*'):
    for path in etc.glob(pattern):
        path.unlink()
PYBACKUP
            rm -f /etc/spacemit-ai-gateway/credentials.env /etc/spacemit-ai-gateway/.legacy-migrated \
              /etc/spacemit-ai-gateway/voice-api-key \
              /etc/tmpfiles.d/spacemit-ai-gateway-voice-access.conf
            # migrate 生成的 drop-in 不属于 dpkg 文件清单；purge 不清掉会让下一次
            # 升级读到已被删除的新配置路径（preinst 报 FileNotFoundError）。
            /usr/bin/python3 - <<'PYCONFIG'
from pathlib import Path
path = Path('/opt/spacemit-ai-gateway/configs/base.yaml')
if path.is_symlink() and path.readlink() == Path('/etc/spacemit-ai-gateway/base.yaml'):
    path.unlink()
PYCONFIG
            rm -f /etc/systemd/system/spacemit-ai-gateway.service.d/00-legacy-runtime.conf \
              /etc/systemd/system/spacemit-ai-gateway-frontend.service.d/00-legacy-runtime.conf \
              /etc/systemd/system/spacemit-ai-gateway-frontend.service.d/legacy-listener.conf
            rmdir /etc/systemd/system/spacemit-ai-gateway.service.d \
              /etc/systemd/system/spacemit-ai-gateway-frontend.service.d 2>/dev/null || true
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear) ;;
    *) echo "Unexpected postrm argument: $1" >&2; exit 1 ;;
esac
#DEBHELPER#
exit 0
